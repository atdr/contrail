{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  // Passport's authored sources only. Non-recursive, so passport/vendor/ and
  // its upstream builds are never linted or reformatted.
  "files": {
    "includes": ["src/contrail/passport/*.js", "src/contrail/passport/*.css"]
  },
  // 100 to match ruff's line-length.
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        // Biome reads every .js file as an ES module, where strict mode is
        // implied. Passport's scripts are inlined into a classic <script>,
        // where it is not, so each module's "use strict" is doing real work.
        "noRedundantUseStrict": "off"
      }
    }
  },
  "javascript": {
    // Chart, d3 and topojson are provided by the Chart.js, d3-array, d3-geo
    // and topojson-client bundles inlined ahead of the page's own script.
    // Passport is the namespace format.js declares, which every later file
    // in PASSPORT_SCRIPTS adds to.
    "globals": ["Chart", "d3", "topojson", "Passport"],
    "formatter": { "quoteStyle": "double" }
  }
}
